{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apogee/webhook-event/v1",
  "description": "The body of one webhook delivery (runtime.md §2.1).",
  "oneOf": [
    { "$ref": "#/$defs/proven" },
    { "$ref": "#/$defs/executed" },
    { "$ref": "#/$defs/failed" },
    { "$ref": "#/$defs/alert" }
  ],
  "$defs": {
    "format": { "const": "apogee/webhook-event/v1" },
    "id": { "type": "string", "pattern": "^evt_[0-9a-f]{16}$" },
    "batch": { "type": "integer", "minimum": 1 },
    "root": { "type": "string", "pattern": "^0x[0-9a-f]{128}$" },
    "proven": {
      "type": "object",
      "required": ["format", "id", "type", "batch", "root", "proof"],
      "additionalProperties": false,
      "properties": {
        "format": { "$ref": "#/$defs/format" },
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "batch.proven" },
        "batch": { "$ref": "#/$defs/batch" },
        "root": { "$ref": "#/$defs/root" },
        "proof": {
          "type": "object",
          "required": ["identity"],
          "additionalProperties": false,
          "properties": { "identity": { "type": "string", "pattern": "^[0-9a-f]{128}$" } }
        }
      }
    },
    "executed": {
      "type": "object",
      "required": ["format", "id", "type", "batch", "root", "proof"],
      "additionalProperties": false,
      "properties": {
        "format": { "$ref": "#/$defs/format" },
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "batch.executed" },
        "batch": { "$ref": "#/$defs/batch" },
        "root": { "$ref": "#/$defs/root" },
        "proof": { "type": "null" }
      }
    },
    "failed": {
      "type": "object",
      "required": ["format", "id", "type", "batch", "cause", "root"],
      "additionalProperties": false,
      "properties": {
        "format": { "$ref": "#/$defs/format" },
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "batch.failed" },
        "batch": { "$ref": "#/$defs/batch" },
        "cause": { "type": "string" },
        "root": { "$ref": "#/$defs/root" }
      }
    },
    "alert": {
      "type": "object",
      "required": ["format", "id", "type", "alert", "batch", "message"],
      "additionalProperties": false,
      "properties": {
        "format": { "$ref": "#/$defs/format" },
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "host.alert" },
        "alert": { "const": "batch_diverged" },
        "batch": { "$ref": "#/$defs/batch" },
        "message": { "type": "string" }
      }
    }
  }
}
